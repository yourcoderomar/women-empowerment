PORT=3000
# XAMPP MySQL: user root, empty password by default -> mysql://root:@localhost:3306/women_platform
DATABASE_URL=mysql://root:@localhost:3306/women_platform
JWT_SECRET=change-me-to-a-long-random-string
# Needed to register an admin account (user_type "admin" + admin_secret). Leave empty to disable.
ADMIN_SECRET=dev-admin-secret
